{
  "name": "pal-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API backend du réseau social Pal",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate:social-index": "node scripts/migrateSocialIndex.js",
    "test": "node --test",
    "check": "node --check api/index.js && node --check src/app.js && node --check src/server.js && find src api tests scripts -name \"*.js\" -print0 | xargs -0 -n1 node --check"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.0.0",
    "openai": "^7.57.0",
    "zod": "^4.6.7",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "nodemailer": "^6.10.1",
    "multer": "^2.0.2",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4"
  }
}
