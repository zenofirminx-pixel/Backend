rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Toutes les lectures et écritures passent par l'API OpenDC avec Firebase Admin.
    // Le SDK Admin contourne ces règles ; aucun client web/mobile ne reçoit d'accès direct.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
