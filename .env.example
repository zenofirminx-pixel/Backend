NODE_ENV=development
PORT=3000
CORS_ORIGINS=https://opendc.vercel.app,http://localhost:5173
FRONTEND_URL=https://opendc.vercel.app
PUBLIC_API_URL=https://backend-two-teal-20.vercel.app

# Firebase Admin (server only)
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_STORAGE_BUCKET=

# Email delivery (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# AI service (optional for assistant)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Two-factor authentication (TOTP)
TOTP_ENCRYPTION_KEY=
