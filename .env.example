# Serveur
NODE_ENV=development
PORT=3000

# URL(s) exactes du frontend OpenDC, séparées par des virgules.
# Exemple : https://opendc.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Firebase Admin — choisir UNE méthode.
# Méthode A (recommandée sur Vercel) : JSON complet du compte de service encodé en base64.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Méthode B : champs individuels du compte de service (la clé privée garde les \n échappés).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Bucket Firebase Storage, ex. mon-projet.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# OpenAI — secret exclusivement côté serveur.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=900

# Assistant et limites
ASSISTANT_MAX_MESSAGE_CHARS=2000
ASSISTANT_MAX_HISTORY_MESSAGES=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
ASSISTANT_RATE_LIMIT_MAX=12

# Sécurité facultative : désactiver la vérification de révocation uniquement pour tests locaux.
FIREBASE_CHECK_REVOKED=true
